# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# OTP hashing pepper. Generate a strong random value for production.
OTP_PEPPER=replace_with_a_long_random_secret

# Preferred OTP/notification email delivery: Brevo Transactional Email
BREVO_API_KEY=xkeysib_replace_with_your_brevo_api_key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Sahil Portfolio

# Optional SMTP fallback if Brevo is not configured
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL="Sahil Portfolio <no-reply@example.com>"

# Optional: where new booking/UPI submission notifications are sent.
BOOKING_NOTIFY_EMAIL=minersahil20@gmail.com

# Direct UPI checkout
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Sahil Sinha
UPI_TRANSACTION_NOTE=Sahil Portfolio Booking
